{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/routes/products.ts",
    "server/routes/assembly-scheduling.ts",
    "server/routes/engineering-changes.ts",
    "server/routes/startup-diagnostics.ts",
    "server/services/product-*.ts",
    "src/types/product.ts",
    "server/services/wecom-app.ts"
  ]
}
