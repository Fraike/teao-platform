# ===================================
# 特澳科技业务工具平台 - 环境变量模板
# ===================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
#
# 生产环境：在 systemd service 文件中通过 Environment= 设置
# 本地开发：创建 .env 文件（已被 .gitignore 忽略）
#
# 重要：JWT_SECRET 为必填项，缺少则 API 服务无法启动！

# ---- JWT 认证（必填） ----
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ---- 数据存储目录（可选） ----
# 默认自动选择：生产环境 /var/www/teao-platform/data，开发环境项目根目录 data/
# DATA_DIR=/var/www/teao-platform/data

# ---- API 认证（维格表操作） ----
API_PASSWORD=teao123

# ---- 维格表配置 ----
VIKA_TOKEN=your_vika_token_here
ASSEMBLY_DATASHEET_ID=your_assembly_datasheet_id
ASSEMBLY_VIEW_ID=your_assembly_view_id
INJECTION_DATASHEET_ID=your_injection_datasheet_id
INJECTION_VIEW_ID=your_injection_view_id

# ---- 企业微信通知 ----
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# ---- 金蝶云星辰 API（测试脚本使用） ----
KINGDEE_CLIENT_ID=your_kingdee_client_id
KINGDEE_CLIENT_SECRET=your_kingdee_client_secret

# ---- 生产日报推送定时 ----
CRON_EXPRESSION=0 0 13 * * *
PRODUCTION_REPORT_ENABLED=true
